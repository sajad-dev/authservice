{
  "@type": "type.googleapis.com/envoy.config.cluster.v3.Cluster",
  "name": "service_cluster",
  "type": "STRICT_DNS",
  "connect_timeout": "1s",
  "lb_policy": "ROUND_ROBIN",
  "load_assignment": {
    "cluster_name": "service_cluster",
    "endpoints": [
      {
        "lb_endpoints": [
          {
            "endpoint": {
              "address": {
                "socket_address": {
                  "address": "service",
                  "port_value": 8080
                }
              }
            }
          }
        ]
      }
    ]
  }
}
