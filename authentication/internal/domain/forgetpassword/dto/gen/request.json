{
  "ProtoPackage": "forgetpasswordproto",
  "ImportPath": [
    "github.com/sajad-dev/authservice/authentication/internal/domain/forgetpassword/forgetpasswordproto"
  ],
  "Data": [
    {
      "Name": "forget",
      "Data": {
        "FuncName": "ToRequestForget",
        "StructName": "ForgetRequest",
        "ProtoStruct": "ForgetRequest",
        "Fields": [
          {
            "To": "Email",
            "Type": "string",
            "From": "Email",
            "Validations": "required,exists=accounts",
            "Json": "email"
          }
        ]
      }
    },
    {
      "Name": "reset",
      "Data": {
        "FuncName": "ToRequestReset",
        "StructName": "ResetRequest",
        "ProtoStruct": "ResetRequest",
        "Fields": [
          {
            "To": "Token",
            "Type": "string",
            "From": "Token",
            "Validations": "required",
            "Json": "token"
          },
          {
            "To": "PasswordConfirmation",
            "Type": "string",
            "From": "PasswordConfirmation",
            "Validations": "required,eqfield=Password",
            "Json": "password_confirmation"
          },
          {
            "To": "Password",
            "Type": "string",
            "From": "Password",
            "Validations": "required,min=8",
            "Json": "password"
          }
        ]
      }
    }
  ]
}
